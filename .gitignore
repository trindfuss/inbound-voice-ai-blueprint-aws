# Secrets and credentials: never commit. Twilio credentials live only in AWS Secrets Manager;
# scripts read them from there.
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
secrets/
credentials*
*.secret

# Local Claude Code settings (machine-specific paths)
.claude/settings.local.json

# Build and tooling output
node_modules/
cdk.out/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
dist/
.DS_Store
.mypy_cache/
.ruff_cache/
infra/build/

# A local clone of other repositories, not part of this project
skills/

# Per-environment deploy outputs (regenerated by `cdk deploy --outputs-file` and
# scripts/twilio_setup.py); they hold your account's ARNs and Twilio SIDs
infra/cdk-outputs.json
infra/twilio.context.json
# CDK's context cache; preflight --agentcore writes the account's AZ name -> ID map here under a key
# that holds the account ID
infra/cdk.context.json
.claude/worktrees/

# Benchmark results (scripts/bench/ writes here)
bench/results/
