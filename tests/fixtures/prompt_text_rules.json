    {"name": "spoken: SSML", "key": "greeting.generic", "current": "Hello.", "text": "<speak>Hello.</speak>", "accept": false},
    {"name": "spoken: placeholder dropped", "key": "greeting.personal", "current": "Thanks, {firstName}.", "text": "Thanks.", "accept": false},
    {"name": "spoken: stray brace", "key": "greeting.personal", "current": "Thanks, {firstName}.", "text": "Thanks, {firstName} }", "accept": false},
