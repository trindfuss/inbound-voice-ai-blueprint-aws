    {"name": "agent: caller frame stray brace", "key": "agent.caller_context", "current": "{firstName} {profile} {memory}", "text": "{firstName} {profile} {memory} {", "accept": false},
    {"name": "agent: empty", "key": "agent.system.x", "current": "Hi.", "text": "", "accept": false},
    {"name": "agent: blank", "key": "agent.system.x", "current": "Hi.", "text": " \n\t\u0085　", "accept": false},
    {"name": "D5: a pre-feature set kept is refused", "key": "agent.system.x", "current": "Hi {firstName}. {profile} {memory}", "text": "Hi {firstName}. {profile} {memory}", "accept": false},
