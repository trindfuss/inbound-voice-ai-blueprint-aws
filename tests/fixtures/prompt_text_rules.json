{
  "_notes": [
    "Shared accept/refuse table for one language's prompt text.",
    "Asserted by BOTH tests/unit/lambdas/test_admin_api.py (config_routes._check_prompt_text) and",
    "src/admin_console/tests/validate.test.js (lib/validate.js checkPromptTexts), so the API and the",
    "console cannot drift. The text is `text`, then `pad_char` (default \"a\") repeated until it is",
    "`pad_to` code points long. `current` is the saved text (null: no same-set rule).",
    "agent.* : at most 16,000, '<' and '>' allowed. Spoken keys: at most 600, no '<' or '>'.",
    "Both: non-empty (Python's str.strip) and no stray brace. Spoken keys keep the current text's",
    "placeholder set. agent.* keys have exactly their key's allowed set,",
    "whatever the current text has, new keys included: agent.caller_context exactly {firstName},",
    "{memory}, {profile}; every other agent.* key none."
  ],
  "cases": [
    {"name": "agent: caller frame keeps its set", "key": "agent.caller_context", "current": "Hi {firstName}. {profile} {memory}", "text": "Hello {firstName}. {memory} {profile}", "accept": true},
    {"name": "agent: 16,000", "key": "agent.system.x", "current": "Hi.", "text": "Hi.", "pad_to": 16000, "accept": true},
    {"name": "agent: 16,001", "key": "agent.system.x", "current": "Hi.", "text": "Hi.", "pad_to": 16001, "accept": false},
    {"name": "agent: caller frame at 16,000", "key": "agent.caller_context", "current": "{firstName} {profile} {memory}", "text": "{firstName} {profile} {memory}", "pad_to": 16000, "accept": true},
    {"name": "agent: 16,000 astral code points", "key": "agent.system.x", "current": "Hi.", "text": "Hi.", "pad_char": "😀", "pad_to": 16000, "accept": true},
    {"name": "agent: 16,001 astral code points", "key": "agent.system.x", "current": "Hi.", "text": "Hi.", "pad_char": "😀", "pad_to": 16001, "accept": false},
    {"name": "agent: 601 is fine", "key": "agent.web_activity", "current": "Offer.", "text": "Offer.", "pad_to": 601, "accept": true},
    {"name": "agent: markup", "key": "agent.system.x", "current": "Hi.", "text": "<rules>\nHi. a > b\n</rules>", "accept": true},
    {"name": "agent: caller frame markup", "key": "agent.caller_context", "current": "{firstName} {profile} {memory}", "text": "<caller_context>\n{firstName} {profile} {memory}\n</caller_context>", "accept": true},
    {"name": "agent: SSML-looking", "key": "agent.call_started", "current": "Call started.", "text": "<speak>Call started.</speak>", "accept": true},
